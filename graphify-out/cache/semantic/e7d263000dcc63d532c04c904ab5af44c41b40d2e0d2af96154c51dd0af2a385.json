{"nodes": [{"id": "log_decisions_md", "label": "Log des Decisions Architecturales", "file_type": "document", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rationale_tph_strategy", "label": "TPH Strategy Rationale", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 3 - EF Core TPH", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TPH chosen over TPT/separate tables because Transaction is a shared base class with common properties, resulting in simpler queries (single table), good performance for the data volume, and automatic inheritance for DepenseFixe and TransactionVariable."}, {"id": "rationale_jwt_delegating_handler_disabled", "label": "Rationale: DelegatingHandler Disabled for JWT", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 4 - Token JWT dans FrontServices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JwtAuthorizationHandler (DelegatingHandler) is disabled because ProtectedLocalStorage uses JS interop, which is not accessible in the HTTP handler context. The token is instead added per-request in each FrontService via GetClientAsync()."}, {"id": "rationale_prerender_disabled", "label": "Rationale: Prerendering Disabled", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 5 - Prerendering desactive", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InteractiveServerRenderMode(prerender: false) set in App.razor because ProtectedLocalStorage requires JS interop, which is unavailable during static rendering phase."}, {"id": "rationale_proactive_refresh_timer", "label": "Rationale: Proactive JWT Refresh Timer", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "2025-02 - Refresh Token Proactif", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer-based proactive refresh (3 min before expiry) chosen over refresh-on-API-call because inactive users could let token expire, and the timer runs server-side on the Blazor circuit without needing JS interop."}, {"id": "rationale_authorize_view_in_main_layout", "label": "Rationale: AuthorizeView in MainLayout", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 3 - AuthorizeView dans MainLayout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AuthorizeView placed in MainLayout (not AuthorizeRouteView in Routes.razor, not [Authorize] per page) because it protects all pages using MainLayout uniformly, and AuthorizeRouteView caused infinite redirect loops when combined with MainLayout."}, {"id": "rationale_categories_global", "label": "Rationale: Categories Are Global (Not Per-User)", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 2 - Categories globales", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Categories are shared across all users to avoid duplication. Generic categories (Food, Transport, etc.) are not user-specific and simplify management."}, {"id": "rationale_docker_no_https", "label": "Rationale: HTTPS Disabled in App (Traefik Handles SSL)", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "2025-01 - Deploiement Docker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UseHttpsRedirection and UseHsts removed because Traefik handles SSL termination. The app receives plain HTTP from Traefik; keeping these middlewares caused 404s on static files in Production."}, {"id": "rationale_null_handling_tph", "label": "Rationale: TPH NULL Handling in LINQ (== false not !)", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 5 - NULL handling IsEchelonne TPH", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In TPH columns nullable in SQL, !IsEchelonne in LINQ treats NULL as neither true nor false, accidentally excluding TransactionVariable rows. Using == false generates WHERE IsEchelonne = 0 which correctly handles NULLs."}, {"id": "rationale_clean_architecture_4_projects", "label": "Rationale: Clean Architecture with 4 Projects", "file_type": "rationale", "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Decision 2 - Structure en 4 projets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4-project structure (Entities, Application, Shared, Frontend) chosen for clear separation of concerns, component reusability, testability (layer isolation), and Clean Architecture pattern."}], "edges": [{"source": "log_decisions_md", "target": "obsidian_readme_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Line 435", "weight": 1.0}, {"source": "log_decisions_md", "target": "obsidian_architecture_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Line 436", "weight": 1.0}, {"source": "log_decisions_md", "target": "entites_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": "Line 437", "weight": 1.0}, {"source": "rationale_tph_strategy", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_tph_strategy", "target": "entites_md", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_jwt_delegating_handler_disabled", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_prerender_disabled", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_proactive_refresh_timer", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_authorize_view_in_main_layout", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_categories_global", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_docker_no_https", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_null_handling_tph", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}, {"source": "rationale_clean_architecture_4_projects", "target": "obsidian_architecture_md", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ObsidianDocs/01-Projets/BudgetApp/Log-Decisions.md", "source_location": null, "weight": 1.0}], "hyperedges": []}